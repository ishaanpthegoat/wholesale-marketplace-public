# ─── Supabase ────────────────────────────────────────────────────────────────
# Local: run `npm run db:start` and copy the values it prints.
# Hosted: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never expose to the client, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe Connect (test mode) ──────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From `npm run stripe:listen`, or the Dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Platform take rate in basis points. 800 = 8%.
PLATFORM_FEE_BPS=800

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret for the offer-expiry cron route. Generate: openssl rand -hex 32
CRON_SECRET=

# ─── Email (offer state-change notifications) ────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Pallet <notifications@example.com>"
